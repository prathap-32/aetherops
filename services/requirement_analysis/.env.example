# Database & Cache Environment Configuration

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aether_catalog

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Optional explicit SQLAlchemy Database URL overrides
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/aether_catalog

# Admin Security & JWT Configuration
# In production, generate keys with: openssl rand -hex 32
ADMIN_SECRET_KEY=replace-with-secure-32-byte-hex-string-for-production
JWT_SECRET_KEY=replace-with-secure-32-byte-hex-string-for-production
JWT_EXPIRATION_HOURS=8
# Default credentials should only be used in development/testing environments
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=replace-with-strong-password-in-production
DEFAULT_ADMIN_EMAIL=admin@aetherops.cloud
