# ═══════════════════════════════════════════════════════════════════════════════
# AetherOps Cloud DevOps Platform — Global Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
# NOTE: Never commit sensitive production credentials or literal keys to version control.
# Copy this template to .env and configure environment-specific values.

# Environment Mode: 'development', 'staging', or 'production'
AETHER_ENV=development

# Database & Cache Infrastructure
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/aetherops_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=aetherops_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0

# Security & Master Auth
# IMPORTANT: In production, JWT_SECRET_KEY must be a cryptographically random string (min 32 bytes).
# Generate using: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-secure-32-byte-hex-string-for-production
JWT_EXPIRATION_HOURS=8

# Master API Key (Disabled in production mode)
ADMIN_API_KEY=replace-with-secure-admin-api-key-or-leave-empty-in-production

# Default Administrative User Setup (Seeding is disabled in production mode)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=replace-with-strong-administrator-password

# GitHub OAuth App Configuration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Google OAuth App Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# AWS Cloud Provider Credentials (Sandbox / Plan Inspection Only — Live Provisioning Disabled)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Microservices Network Endpoints (Ports 8000-8012)
GATEWAY_URL=http://localhost:8000
PM_SERVICE_URL=http://localhost:8001
SC_SERVICE_URL=http://localhost:8002
REPO_ANALYZER_SERVICE_URL=http://localhost:8003
REQ_SERVICE_URL=http://localhost:8004
ARCH_SERVICE_URL=http://localhost:8004
IAC_SERVICE_URL=http://localhost:8006
FINOPS_SERVICE_URL=http://localhost:8007
SEC_SERVICE_URL=http://localhost:8008
CICD_SERVICE_URL=http://localhost:8009
OBS_SERVICE_URL=http://localhost:8010
DEPLOYER_SERVICE_URL=http://localhost:8011
ADMIN_SERVICE_URL=http://localhost:8012

# Google Gemini Cloud LLM Configuration (Module 3 Universal Scanner & Sizing)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_CONCURRENT=4
GEMINI_CACHE_ENABLED=true
GEMINI_FALLBACK_ON_ERROR=true
